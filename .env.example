# Environment Variables
# Copy this file to .env.local and fill in the values.

# Required: base URL for canonical links, OG images, and sitemaps.
# In production: https://makminaret.com
# In preview/staging: the Vercel preview URL (Vercel supplies VERCEL_URL as a
# fallback, so this can be left unset on preview deployments)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Site mode (HANDOVER §3.4)
#   showcase  default. Placeholder content allowed. Whole site emits noindex,
#             nofollow, and a dismissible preview bar renders.
#   live      the build FAILS while any placeholder: true remains.
# Flip to live only when content/PLACEHOLDERS.md is empty.
SITE_MODE=showcase
