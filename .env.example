# Environment Variables
# Copy this file to .env.local and fill in the values.

# Required: base URL for canonical links, OG images, and sitemaps.
# In production: https://makminaret.com
# In preview/staging: the Vercel preview URL (Vercel supplies VERCEL_URL as a
# fallback, so this can be left unset on preview deployments)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Site mode (HANDOVER §3.4)
#   showcase  default. Placeholder content allowed. noindex, nofollow, and a
#             dismissible preview bar renders.
#   unlisted  same, minus the preview bar. The site looks finished on the real
#             domain while staying invisible to search.
#   live      indexable, no bar. The build FAILS while any placeholder: true
#             remains, so live is unreachable until PLACEHOLDERS.md is empty.
#
# Only `live` is indexable. Removing the preview bar cannot accidentally
# publish draft content to search engines.
SITE_MODE=showcase
